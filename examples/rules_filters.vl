# Fallback columns (`or(...)`), skip predicates and mapping filters.
#
# Run with:
#   fvalidate examples/loose.csv -r examples/rules_filters.vl --id-column id

# `or(a, b, c)` uses the first non-empty column as the source value.
rule "fallback picks the first available code" {
  left  = or(code_a, code_b, code_c)
  right = expected
  compare = eq
}

# `validation_skipped` marks matching rows as skipped instead of failed.
rule "archived rows are skipped" {
  left  = or(code_a, code_b, code_c)
  right = expected
  validation_skipped = in(status, ["archived", "deleted"])
}

# `any_in` skips a row when any of the listed columns holds one of the values.
rule "sentinel rows are skipped" {
  left  = or(code_a, code_b, code_c)
  right = expected
  validation_skipped = any_in([code_a, code_b, code_c], ["SKIP", "N/A"])
}

# A `mapping_filter` restricts the relation to primary rows: secondary rows are
# skipped, and only primary rows feed the mapping if it is auto-extracted.
rule "reference mapping restricted to primary rows" {
  left           = or(code_a, code_b, code_c)
  right          = expected
  mapping_files  = ["examples/loose_map.csv"]
  mapping_left   = code
  mapping_right  = expected
  mapping_filter = eq(kind, "primary")
}

rule "auto mapping only sees primary rows" {
  left           = or(code_a, code_b, code_c)
  right          = expected
  mapping        = auto
  mapping_filter = eq(kind, "primary")
}
